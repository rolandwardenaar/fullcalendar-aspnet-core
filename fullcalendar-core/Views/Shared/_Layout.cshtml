<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kalender</title>

    <link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" />
    <style>
        body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .layout-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            background-color: #343a40;
            width: 250px;
            padding: 1.5rem 1rem;
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 1000;
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
            overflow-y: auto;
        }

        .sidebar-brand {
            color: white;
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 2rem;
            display: block;
            text-decoration: none;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar-brand:hover {
            color: white;
        }

        .user-info {
            background-color: rgba(255,255,255,0.1);
            padding: 0.75rem;
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            color: rgba(255,255,255,.85);
        }

        .user-info strong {
            display: block;
            color: white;
            margin-bottom: 0.25rem;
        }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .nav-menu li {
            margin-bottom: 0.5rem;
        }

        .nav-link {
            color: rgba(255,255,255,.75);
            text-decoration: none;
            padding: 0.75rem 1rem;
            display: block;
            border-radius: 0.5rem;
            transition: all 0.2s;
            font-weight: 500;
        }

        .nav-link:hover {
            background-color: rgba(255,255,255,0.1);
            color: white;
            transform: translateX(5px);
        }

        .nav-link.active {
            background-color: rgba(255,255,255,0.2);
            color: white;
        }

        .btn-logout {
            background: none;
            border: 1px solid rgba(255,255,255,.75);
            color: rgba(255,255,255,.75);
            padding: 0.75rem 1rem;
            cursor: pointer;
            border-radius: 0.5rem;
            transition: all 0.2s;
            width: 100%;
            margin-top: 1rem;
            font-weight: 500;
        }

        .btn-logout:hover {
            background-color: rgba(255,255,255,.1);
            color: white;
            border-color: white;
        }

        /* Event Type Filter Styles */
        .event-filter-section {
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .filter-title {
            color: white;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 1rem;
            letter-spacing: 0.5px;
        }

        .filter-checkboxes {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .filter-checkbox {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem;
            border-radius: 0.375rem;
            cursor: pointer;
            transition: background-color 0.2s;
            color: rgba(255,255,255,.85);
            font-size: 0.9rem;
        }

        .filter-checkbox:hover {
            background-color: rgba(255,255,255,0.05);
        }

        .filter-checkbox input[type="checkbox"] {
            cursor: pointer;
            width: 16px;
            height: 16px;
        }

        .event-type-indicator {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 0.25rem;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .filter-actions {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .btn-filter-action {
            background: rgba(255,255,255,0.1);
            border: none;
            color: rgba(255,255,255,.75);
            padding: 0.5rem;
            cursor: pointer;
            border-radius: 0.375rem;
            transition: all 0.2s;
            flex: 1;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .btn-filter-action:hover {
            background-color: rgba(255,255,255,.2);
            color: white;
        }

        .main-content {
            margin-left: 250px;
            flex: 1;
            min-height: 100vh;
        }
    </style>
</head>
<body>
    @inject Microsoft.AspNetCore.Identity.SignInManager<fullcalendarcore.Models.ApplicationUser> SignInManager
    @inject Microsoft.AspNetCore.Identity.UserManager<fullcalendarcore.Models.ApplicationUser> UserManager

    <div class="layout-container">
        @if (SignInManager.IsSignedIn(User))
        {
            var currentUser = await UserManager.GetUserAsync(User);
            <aside class="sidebar">
                <a class="sidebar-brand" href="/">📅 Kalender</a>

                <div class="user-info">
                    <strong>Ingelogd als:</strong>
                    @(currentUser?.DisplayName ?? currentUser?.UserName)
                </div>

                <ul class="nav-menu">
                    <li>
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            🏠 Home
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li>
                            <a class="nav-link" asp-controller="Account" asp-action="ManageUsers">
                                👥 Gebruikersbeheer
                            </a>
                        </li>
                    }
                    <li>
                        <a class="nav-link" asp-controller="Account" asp-action="ChangePassword">
                            🔒 Wachtwoord wijzigen
                        </a>
                    </li>
                </ul>

                <!-- Event Type Filter -->
                <div class="event-filter-section">
                    <h6 class="filter-title">Eventtypes filteren</h6>
                    <div class="filter-checkboxes">
                        <label class="filter-checkbox">
                            <input type="checkbox" value="0" checked data-event-type-filter>
                            <span class="event-type-indicator" style="background-color: #1565c0; border: 2px solid rgba(255,255,255,0.3);">📅</span>
                            <span>Afspraak</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="1" checked data-event-type-filter>
                            <span class="event-type-indicator" style="background-color: #c2185b; border: 2px solid rgba(255,255,255,0.3);">🎂</span>
                            <span>Verjaardag</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="2" checked data-event-type-filter>
                            <span class="event-type-indicator" style="background-color: #7b1fa2; border: 2px solid rgba(255,255,255,0.3);">💐</span>
                            <span>Jubileum</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="3" checked data-event-type-filter>
                            <span class="event-type-indicator" style="background-color: #ef6c00; border: 2px solid rgba(255,255,255,0.3);">⏰</span>
                            <span>Herinnering</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="4" checked data-event-type-filter>
                            <span class="event-type-indicator" style="background-color: #2e7d32; border: 2px solid rgba(255,255,255,0.3);">✓</span>
                            <span>Taak</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="5" checked data-event-type-filter>
                            <span class="event-type-indicator" style="background-color: #c62828; border: 2px solid rgba(255,255,255,0.3);">🎉</span>
                            <span>Vakantie</span>
                        </label>
                        <label class="filter-checkbox">
                            <input type="checkbox" value="6" checked data-event-type-filter>
                            <span class="event-type-indicator" style="background-color: #37474f; border: 2px solid rgba(255,255,255,0.3);">📌</span>
                            <span>Overig</span>
                        </label>
                    </div>
                    <div class="filter-actions">
                        <button type="button" class="btn-filter-action" id="selectAllTypes">Alles selecteren</button>
                        <button type="button" class="btn-filter-action" id="deselectAllTypes">Alles deselecteren</button>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                    <button type="submit" class="btn-logout">🚪 Uitloggen</button>
                </form>
            </aside>
        }

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script type="module" src="~/js/calendar.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
