@model List<fullcalendarcore.Models.UserManagementViewModel>
@{
    ViewData["Title"] = "Gebruikersbeheer";
}

<div class="container-fluid" style="padding: 2rem;">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>@ViewData["Title"]</h2>
            <hr />
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-12">
            <a asp-action="Register" class="btn btn-primary btn-lg">
                ➕ Nieuwe gebruiker aanmaken
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Gebruikersnaam</th>
                                <th>Weergavenaam</th>
                                <th>Email</th>
                                <th>Rollen</th>
                                <th>Acties</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Username</td>
                                    <td>@user.DisplayName</td>
                                    <td>@user.Email</td>
                                    <td>@user.Roles</td>
                                    <td>
                                        <form asp-action="DeleteUser" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm" 
                                                    onclick="return confirm('Weet je zeker dat je gebruiker @user.Username wilt verwijderen?');">
                                                🗑️ Verwijderen
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (Model.Count == 0)
                    {
                        <p class="text-muted text-center py-4">Geen gebruikers gevonden.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
